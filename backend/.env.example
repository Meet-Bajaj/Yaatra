# Yaatra Backend Environment Variables

# Server
PORT=5001

# Database
DATABASE_URL=postgresql://admin:SuperSecurePassword123!@localhost:5432/yaatri

# JWT
JWT_SECRET=yaatra-jwt-secret-2024-change-in-production

# OTP Provider (msg91 or twilio)
OTP_PROVIDER=msg91
OTP_API_KEY=your_otp_api_key

# Redis
REDIS_URL=redis://localhost:6379

# Razorpay (Payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key

# AWS S3 (Document uploads)
AWS_S3_BUCKET=your_s3_bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# DigiLocker (optional - Phase 1.5)
DIGILOCKER_API_KEY=your_digilocker_api_key

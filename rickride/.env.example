# RickRide frontend environment variables
# Copy this file to `.env` and adjust the values for your local device.

EXPO_PUBLIC_APP_ENV=development

# Backend API base URL.
# Android emulator: http://10.0.2.2:5000/api/v1
# iOS simulator: http://127.0.0.1:5000/api/v1
# Physical device: http://YOUR_LOCAL_IP:5000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5000/api/v1

# Socket.IO base URL.
EXPO_PUBLIC_SOCKET_URL=http://127.0.0.1:5000

# Razorpay publishable key used by the confirmation screen.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_example

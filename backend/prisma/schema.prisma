generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  // url is configured in prisma.config.ts
}

//
// ENUMS
//

enum UserRole {
  RIDER
  DRIVER
  CARPOOL
  PROFESSIONAL
  BOTH
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum DriverType {
  CARPOOL
  PROFESSIONAL
  BOTH
}

enum VerificationStatus {
  PENDING
  PASSED
  FAILED
}

enum RideStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum RideInstanceStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum TripStatus {
  SEARCHING
  DRIVER_ASSIGNED
  ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum PaymentType {
  AUTH
  CAPTURE
  REFUND
}

enum TransactionStatus {
  SUCCEEDED
  FAILED
  PENDING
}

enum WalletTxnType {
  TOPUP
  DEBIT
  REFUND
  ADJUSTMENT
}

enum KycDocumentType {
  AADHAAR
  DRIVING_LICENSE
  PAN
}

enum OtpPurpose {
  LOGIN
  VERIFY_DOC
  RESET
}

//
// OTP
//

model Otp {
  id        String   @id @default(uuid()) @map("otp_id")
  phone     String
  code      String
  purpose   OtpPurpose @default(LOGIN)
  attempts  Int      @default(0)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@map("otps")
}

//
// USERS
//

model User {
  id          String      @id @default(uuid()) @map("user_id")
  phone       String      @unique
  name        String
  email       String?     @unique
  password    String?
  role        UserRole
  status      UserStatus  @default(ACTIVE)

  gender      String?
  city        String?
  avatarUrl   String?     @map("avatar_url")
  emergencyContacts Json? @map("emergency_contacts")
  referralCode String?   @unique @map("referral_code")

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  driverProfile DriverProfile?

  savedPlaces  SavedPlace[]
  bookings      Booking[]
  wallet        Wallet?

  ratingsGiven     Rating[] @relation("Reviewer")
  ratingsReceived  Rating[] @relation("Reviewee")

  notifications Notification[]
  kycDocuments  KycDocument[]

  tripsAsRider   Trip[] @relation("RiderTrips")
  tripsAsDriver  Trip[] @relation("DriverTrips")

  emergencyAlerts EmergencyAlert[]

  @@map("users")
}

//
// DRIVER PROFILE
//

model DriverProfile {
  driverId String @id @map("driver_id")

  driverType       DriverType @default(CARPOOL)
  isOnline         Boolean    @default(false)
  currentLat       Float?
  currentLng       Float?
  currentZone      String?

  verificationStatus VerificationStatus @default(PENDING)

  totalRating Decimal @default(0) @db.Decimal(3,2)
  ratingCount Int @default(0)

  badges Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [driverId], references: [id])

  vehicles Vehicles[]
  recurringRides RecurringRide[]

  @@map("driver_profiles")
}

//
// VEHICLES
//

model Vehicles {
  id String @id @default(uuid()) @map("vehicle_id")

  driverId String

  make String
  model String
  color String?

  licensePlate String @unique @map("license_plate")

  capacity Int

  isCommercial Boolean @default(false)
  fitnessCertUrl String? @map("fitness_cert_url")
  permitUrl String? @map("permit_url")

  verificationStatus VerificationStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  driver DriverProfile @relation(fields: [driverId], references: [driverId])

  rides RecurringRide[]

  @@map("vehicles")
}

//
// RECURRING RIDES
//

model RecurringRide {
  id String @id @default(uuid()) @map("ride_id")

  driverId String
  vehicleId String

  route Unsupported("geography(LINESTRING,4326)")

  schedule Json

  pricePerSeat Decimal @db.Decimal(10,2)

  maxPassengers Int

  womenOnly Boolean @default(false)

  status RideStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  driver DriverProfile @relation(fields: [driverId], references: [driverId])

  vehicle Vehicles @relation(fields: [vehicleId], references: [id])

  instances RideInstance[]

  @@map("recurring_rides")
}

//
// RIDE INSTANCES
//

model RideInstance {
  id String @id @default(uuid()) @map("instance_id")

  rideId String

  date DateTime @db.Date

  departureTime DateTime @db.Time(0)

  status RideInstanceStatus @default(SCHEDULED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ride RecurringRide @relation(fields: [rideId], references: [id])

  bookings Booking[]

  ratings Rating[]

  @@map("ride_instances")
}

//
// TRIPS (on-demand rides)
//

model Trip {
  id        String   @id @default(uuid()) @map("trip_id")
  riderId   String
  driverId  String?
  status    TripStatus @default(SEARCHING)

  pickupLat Float
  pickupLng Float
  dropLat   Float
  dropLng   Float
  pickupAddress String
  dropAddress   String

  fareEstimate Decimal @db.Decimal(10,2)
  fareFinal    Decimal? @db.Decimal(10,2)
  distanceKm   Float?
  durationMin  Int?

  pickupTime DateTime?
  startTime  DateTime?
  endTime    DateTime?

  surgeMultiplier Float? @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rider  User @relation("RiderTrips", fields: [riderId], references: [id])
  driver User? @relation("DriverTrips", fields: [driverId], references: [id])

  payments    Payment[]
  locations   TripLocation[]
  ratings     Rating[]

  @@map("trips")
}

//
// TRIP LOCATIONS (live tracking history)
//

model TripLocation {
  id       String @id @default(uuid()) @map("loc_id")
  tripId   String
  lat      Float
  lng      Float
  speedKmh Float?
  recordedAt DateTime @default(now()) @map("recorded_at")

  trip Trip @relation(fields: [tripId], references: [id])

  @@index([tripId, recordedAt])
  @@map("trip_locations")
}

//
// BOOKINGS
//

model Booking {
  id String @id @default(uuid()) @map("booking_id")

  instanceId String
  riderId String

  seatCount Int

  fareTotal Decimal @db.Decimal(10,2)

  commission Decimal @db.Decimal(10,2)

  paymentStatus PaymentStatus

  bookingStatus BookingStatus

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  instance RideInstance @relation(fields: [instanceId], references: [id])

  rider User @relation(fields: [riderId], references: [id])

  payments Payment[]

  @@map("bookings")
}

//
// PAYMENTS
//

model Payment {
  id String @id @default(uuid()) @map("payment_id")

  bookingId String?
  tripId    String?

  providerTransactionId String? @map("provider_transaction_id")

  amount Decimal @db.Decimal(10,2)

  type PaymentType

  status TransactionStatus

  createdAt DateTime @default(now()) @map("created_at")

  booking Booking? @relation(fields: [bookingId], references: [id])
  trip    Trip?    @relation(fields: [tripId], references: [id])

  @@map("payments")
}

//
// DISPUTES
//

model Dispute {
  id        String @id @default(uuid()) @map("dispute_id")
  bookingId String
  raisedBy  String
  reason    String
  status    String @default("OPEN") // OPEN / RESOLVED / DISMISSED
  resolution String?
  refundAmount Decimal? @db.Decimal(10,2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("disputes")
}

//
// WALLET
//

model Wallet {
  id String @id @default(uuid()) @map("wallet_id")

  userId String @unique

  balance Decimal @default(0) @db.Decimal(12,2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  transactions WalletTransaction[]

  @@map("wallets")
}

//
// WALLET TRANSACTIONS
//

model WalletTransaction {
  id String @id @default(uuid()) @map("txn_id")

  walletId String

  amount Decimal @db.Decimal(10,2)

  type WalletTxnType

  referenceId String? @map("reference_id")

  createdAt DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@map("wallet_transactions")
}

//
// RATINGS
//

model Rating {
  id String @id @default(uuid()) @map("rating_id")

  reviewerId String
  revieweeId String
  rideInstanceId String?
  tripId String?

  score Int

  comment String?
  tags Json?

  createdAt DateTime @default(now()) @map("created_at")

  reviewer User @relation("Reviewer", fields: [reviewerId], references: [id])

  reviewee User @relation("Reviewee", fields: [revieweeId], references: [id])

  rideInstance RideInstance? @relation(fields: [rideInstanceId], references: [id])
  trip         Trip?         @relation(fields: [tripId], references: [id])

  @@map("ratings")
}

//
// NOTIFICATIONS
//

model Notification {
  id String @id @default(uuid()) @map("notif_id")

  userId String

  type String

  payload Json

  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

//
// KYC DOCUMENTS
//

model KycDocument {
  id String @id @default(uuid()) @map("doc_id")

  userId String

  type KycDocumentType

  s3Key String @map("s3_key")

  status VerificationStatus @default(PENDING)

  rejectionReason String? @map("rejection_reason")

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  verifiedAt DateTime? @map("verified_at")

  user User @relation(fields: [userId], references: [id])

  @@map("kyc_documents")
}

//
// SAVED PLACES
//

model SavedPlace {
  id        String @id @default(uuid()) @map("place_id")
  userId    String
  label     String
  name      String
  address   String
  lat       Float
  lng       Float
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("saved_places")
}

//
// EMERGENCY ALERTS
//

model EmergencyAlert {
  id     String @id @default(uuid()) @map("alert_id")
  userId String
  tripId String?
  lat    Float
  lng    Float
  status String @default("OPEN") // OPEN / RESOLVED
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("emergency_alerts")
}

# Yaatra Backend Environment Variables

# Server
PORT=5001

# Database
DATABASE_URL=postgresql://admin:SuperSecurePassword123!@localhost:5432/yaatri

# JWT
JWT_SECRET=yaatra-jwt-secret-2024-change-in-production

# OTP Provider (twilio or msg91)
OTP_PROVIDER=twilio
OTP_API_KEY=your_otp_api_key
OTP_AUTH_TOKEN=your_otp_auth_token
OTP_FROM_NUMBER=your_twilio_number

# Redis
REDIS_URL=redis://localhost:6379

# Razorpay (Payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key

# MinIO (S3-compatible object storage)
# Default credentials for local development: minioadmin / minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yaatra-documents
MINIO_USE_SSL=false

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# CORS
CORS_ORIGIN=http://localhost:3000

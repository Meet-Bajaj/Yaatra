# RikRide Environment Variables Example
# Copy this file to .env and replace with your actual values

# 1. Location & Mapping (Google Maps Platform)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 2. Database, WebSockets & Authentication (Supabase)
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Payment Gateway (Razorpay)
EXPO_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_test_key_id_here
EXPO_PUBLIC_RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret_here

# 4. Backend API & Sockets
EXPO_PUBLIC_APP_ENV=development
# Use 10.0.2.2 for Android Emulator, or http://192.x.x.x for physical devices
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

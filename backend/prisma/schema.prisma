// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = "postgresql://admin:SuperSecurePassword123!@localhost:5432/yaatri"

}


model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  phone     String   @unique
  role      UserRole @default(RIDER) 
  reviews   Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// model Onboarding {
